# ─────────────────────────────────────────────────────────────────────────────
# TeyaTech edge device — environment template
# Copy to .env and fill in. Variables marked (required) MUST be set when
# SUPABASE_DISABLED=false; the rest have sensible defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── Camera / runtime ─────────────────────────────────────────
PORT=5000
CAMERA_INDEX=0
ATTENDANCE_TIMEZONE=America/Sao_Paulo

# Minimum cosine similarity (ArcFace 512-d, L2-normalized).
# 0.45 permissive · 0.55 recommended · 0.65 strict.
RECOGNITION_TOLERANCE=0.55

FRAME_PROCESS_EVERY=3
ENTRY_COOLDOWN_SECONDS=60
EXIT_COOLDOWN_SECONDS=60

# ── Inference backend (ONNX Runtime + InsightFace) ───────────
# Force a provider, or leave blank for auto:
#   tensorrt | cuda | coreml | cpu
INFERENCE_PROVIDER=
INFERENCE_MODEL_PACK=buffalo_sc
INFERENCE_DET_THRESH=0.5

# ── Multi-school + PostgreSQL master sync ────────────────────
# Get SCHOOL_ID/DEVICE_ID from ./scripts/provision_school.sh.
SCHOOL_ID=                              # (required if cloud enabled) UUID of this school
DEVICE_ID=                              # (required if cloud enabled) UUID of this edge device
DEVICE_NAME=portaria-1
# Direct connection to the cloud master PostgreSQL (replaces Supabase).
POSTGRES_HOST=                          # (required if cloud enabled) e.g. db.example.com
POSTGRES_PORT=5432
POSTGRES_DB=                            # (required if cloud enabled)
POSTGRES_USER=                          # (required if cloud enabled)
POSTGRES_PASSWORD=                      # (required if cloud enabled)
POSTGRES_SSLMODE=                       # optional: disable | require | verify-full
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_DISABLED=false                 # set to true for fully offline dev/test
OUTBOX_POLL_SECONDS=5
HEARTBEAT_SECONDS=30
RECONCILE_ON_BOOT=true

# ── Control iD facial collector ──────────────────────────────
# When true, the device performs recognition and POSTs to
# /new_user_identified.fcgi; the local webcam + InsightFace model are NOT loaded.
USE_CONTROL_ID=false
CONTROL_ID_HOST=                        # e.g. 45.163.114.157:8060
CONTROL_ID_USER=                        # device API user (e.g. teya)
CONTROL_ID_PASSWORD=                    # device API password
CONTROL_ID_TIMEOUT_SECONDS=10
MODEL_VERSION=                          # optional tag reported to cloud in Control iD mode

# ── WhatsApp ─────────────────────────────────────────────────
MOCK_MESSAGES=true                      # all 3 providers off → no messages sent
USE_EVOLUTION_API=false
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

USE_META_WHATSAPP=false
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v19.0
DEFAULT_RECIPIENT=

# ── Webhook (opcional) ───────────────────────────────────────
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=1.5
WEBHOOK_RETRY_MAX=2

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=*

# ── Storage ──────────────────────────────────────────────────
FACE_IMAGES_DIR=storage/faces
