# ─────────────────────────────────────────────────────────────
# Face Recognition MVP — Variáveis de Ambiente
# Copie este arquivo para .env e edite conforme necessário:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Servidor ──────────────────────────────────────────────────
PORT=5000
ADMIN_BOOTSTRAP_TOKEN=troque-por-um-segredo-longo
POSTGRES_DSN=postgresql://poc_user:troque-a-senha@localhost:5432/school_poc

# ── CORS (origem do frontend) ─────────────────────────────────
# Lista separada por vírgula das origens autorizadas a chamar a API.
# "*" nunca funciona com login por sessão/cookie (exigência do navegador) —
# sempre informe a(s) URL(s) real(is) do frontend.
CORS_ORIGINS=http://localhost:8080
# Variável antiga (uma origem só), ainda aceita e somada à lista acima:
# CORS_ORIGIN=http://localhost:8080

# ── Sessão de login (cookie httpOnly da interface web) ───────
# Distinta da X-School-Key/dispositivo, que continua existindo para
# integrações, Control iD e o modo "quiosque" do monitor de câmera.
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
# false em dev local (http); true obrigatório em produção (https)
SESSION_COOKIE_SECURE=false
# Lax funciona para front/back no mesmo domínio-base (ex.: localhost:8080 e
# localhost:5000); use None (+ SESSION_COOKIE_SECURE=true) se forem domínios
# diferentes de verdade.
SESSION_COOKIE_SAMESITE=Lax

# ── Reconhecimento Facial ─────────────────────────────────────
# Menor = mais rigoroso (0.40 a 0.60)
RECOGNITION_TOLERANCE=0.50

# ── WhatsApp Business (Meta Cloud API) ────────────────────────
# Canal principal — sem Docker, direto na nuvem da Meta
#
# Como obter:
#   1. https://developers.facebook.com/apps/ → Criar App (Business)
#   2. Adicionar produto: WhatsApp
#   3. WhatsApp → Configuração da API → copiar Token e Phone Number ID
#
USE_META_WHATSAPP=true
META_WHATSAPP_TOKEN=           # Token de acesso (temporário ou permanente)
META_PHONE_NUMBER_ID=          # ID do número de telefone (ex: 123456789012345)
META_API_VERSION=v19.0         # Versão da Graph API

# ── Números de telefone ───────────────────────────────────────
# Formato: DDI + DDD + Número (sem + ou espaços)
SENDER_PHONE=551xxxxxxxx
DEFAULT_RECIPIENT=55xxxxxxx

# ── Evolution API (WhatsApp via Docker) ──────────────────────
# Recomendado: grátis, sem API da Meta, conecta via QR Code
# Suba com: docker run -p 8080:8080 atendai/evolution-api:latest
USE_EVOLUTION_API=false
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=xxxxxxxxxxxxxx
EVOLUTION_INSTANCE=face_mvp

# ── Twilio SMS (alternativo — deixe vazio para usar Meta API) ─
USE_TWILIO=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+155149xxxxxxxxx

# ── Modo de teste: true = não envia mensagens reais ───────────
MOCK_MESSAGES=false

# ── Webhook de auditoria de presença ─────────────────────────
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=1.5
WEBHOOK_RETRY_MAX=2

# Timezone IANA usado na presença legada; cada escola possui seu próprio timezone.
ATTENDANCE_TIMEZONE=America/Sao_Paulo
# Produção: restrinja CORS_ORIGINS à URL real do dashboard e termine HTTPS em proxy reverso.
# O callback Control iD usa segredos cadastrados (hash no SQLite), não variáveis globais.
DB_PATH=database/faces.db
